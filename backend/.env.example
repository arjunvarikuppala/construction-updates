# ============================================================
# SiteTrack Backend Environment Variables — EXAMPLE ONLY
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# Leave MONGODB_URI empty to use the embedded in-memory MongoDB during local
# development (zero-setup). Required in production.
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xyz.mongodb.net/sitetrack?retryWrites=true&w=majority
MONGODB_URI=

# ---------------------------------------------------------------------------
# Authentication — JWT
# Use a cryptographically random 64-character hex string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# REQUIRED in production (min 32 chars) — the server refuses to start without it.
# There is no built-in fallback secret.
JWT_SECRET=replace_with_secure_64_char_random_secret

# Brute-force protection (failed sign-ins per IP+email per 15 min)
LOGIN_RATE_LIMIT_MAX=10
# Reverse-proxy hops in front of the API (Render = 1) so rate limits see real client IPs
TRUST_PROXY_HOPS=1
# Timezone used to bucket analytics by calendar day
REPORT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# CORS — Allowed frontend origin(s)
# Comma-separated list of origins that may make credentialed requests to this
# API. Required in production; in development defaults to permissive '*'.
# Example: CORS_ORIGIN=https://your-sitetrack.vercel.app,http://localhost:5173
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Seeding (development only)
# Set SEED_DEMO=true to populate the in-memory database with sample data on
# startup. Has NO effect when NODE_ENV=production.
# ---------------------------------------------------------------------------
SEED_DEMO=false

# ---------------------------------------------------------------------------
# Cloud Media Storage — Cloudinary (Photos, Videos, PDFs)
# Required in production to avoid uploads being lost on Render redeploys.
# Optional in development (falls back to local disk /uploads).
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Cloud Media Storage — Cloudflare R2 (S3-Compatible, alternative to Cloudinary)
# Optional: leave blank to use local disk storage (/uploads) during offline dev.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sitetrack-media
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# ---------------------------------------------------------------------------
# Weather Integration — Open-Meteo (no API key required for free tier)
# WEATHER_API_KEY is optional; leave blank to use the free Open-Meteo API.
# ---------------------------------------------------------------------------
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# Chat Media Limits
# ---------------------------------------------------------------------------
CHAT_MAX_IMAGE_SIZE_MB=10
CHAT_MAX_VIDEO_SIZE_MB=100

# ---------------------------------------------------------------------------
# Payments — RazorpayX (Optional — only required if payment disbursement is enabled)
# ---------------------------------------------------------------------------
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Required for webhooks: unsigned/invalid webhooks are always rejected (no fallback secret).
RAZORPAYX_WEBHOOK_SECRET=
PAYMENTS_LIVE_ENABLED=false
PAYMENT_HIGH_VALUE_THRESHOLD_PAISE=10000000

# ---------------------------------------------------------------------------
# Merchant Identity (used in UPI QR code generation)
# ---------------------------------------------------------------------------
MERCHANT_UPI_VPA=
MERCHANT_BUSINESS_NAME=SiteTrack Infra Pvt Ltd
