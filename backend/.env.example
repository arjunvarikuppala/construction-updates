PORT=5000
NODE_ENV=development
JWT_SECRET=sitetrack_super_secure_jwt_secret_dev_2026_key
# Leave MONGODB_URI empty for embedded in-memory MongoDB during local dev/demo,
# or provide your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/sitetrack?retryWrites=true&w=majority
MONGODB_URI=
# Cloudinary Cloud Media Storage (Alternative for Photos & Videos)
CLOUDINARY_CLOUD_NAME=da5utvand
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 Cloud Object Storage (S3-Compatible, $0 Egress fees, 100GB+ storage)
# Optional: Leave blank to use local disk storage (/uploads) during offline dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sitetrack-media
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
