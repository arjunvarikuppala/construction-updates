# ============================================================
# SiteTrack Frontend Environment Variables — EXAMPLE ONLY
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ---------------------------------------------------------------------------
# Backend API Origin
#
# Development: Leave VITE_API_URL blank (or do not create .env.local at all).
#   The Vite dev server proxies /api/* and /socket.io/* to localhost:5000
#   automatically via vite.config.ts.
#
# Production (Vercel): Set this to your full Render backend URL.
#   VITE_API_URL=https://your-sitetrack-api.onrender.com
#
# IMPORTANT: This value is baked into the compiled JavaScript bundle at build
# time and is visible to all users. Do NOT set backend secrets here.
# ---------------------------------------------------------------------------
VITE_API_URL=

# ---------------------------------------------------------------------------
# Socket.IO Origin (optional — defaults to VITE_API_URL if not set)
#
# Set only if your WebSocket server runs on a different host than VITE_API_URL.
# Usually the same as VITE_API_URL.
# ---------------------------------------------------------------------------
VITE_SOCKET_URL=
