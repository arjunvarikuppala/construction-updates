# Cloudflare response headers (same caching rules as vercel.json).
# Page routing (every unknown path loads index.html) is set in frontend/wrangler.jsonc.

# Service worker: always check for a new version, so updates reach phones quickly
/sw.js
  Cache-Control: no-cache

# Hashed JS/CSS bundles never change once built
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000
